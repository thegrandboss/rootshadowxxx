<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background:
        radial-gradient(circle at top, #163b0b, #020402 45%),
        #020402;
    color: white;
}

/* ================= NAVBAR ================= */

nav {
    position: sticky;
    top: 0;
    z-index: 1000;

    background: rgba(0,0,0,.90);
    backdrop-filter: blur(15px);

    border-bottom: 1px solid #39ff14;
}

.nav-container {
    width: 92%;
    max-width: 1200px;
    margin: auto;

    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 18px 0;
}

.logo {
    color: #39ff14;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 3px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    font-size: 13px;
    font-weight: bold;
}

nav a:hover {
    color: #39ff14;
}

/* ================= HERO ================= */

.hero {
    min-height: 90vh;

    display: flex;
    align-items: center;

    padding: 70px 0;
}

.hero-container {
    width: 92%;
    max-width: 1200px;
    margin: auto;

    display: grid;
    grid-template-columns: 1fr;

    gap: 50px;
    align-items: center;
}

.small-title {
    color: #39ff14;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 4px;

    margin-bottom: 20px;
}

h1 {
    font-size: clamp(55px, 8vw, 105px);

    line-height: .85;

    text-transform: uppercase;

    letter-spacing: -5px;
}

h1 span {
    color: #39ff14;

    text-shadow:
        0 0 10px #39ff14,
        0 0 30px #39ff14;
}

.hero-text {
    color: #aaa;

    font-size: 18px;

    max-width: 800px;

    margin: 30px 0;
}

/* ================= BUTTON ================= */

.buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    display: inline-block;

    padding: 14px 22px;

    border: 1px solid #39ff14;

    color: white;

    text-decoration: none;

    font-weight: bold;

    transition: .3s;
}

.btn:hover {
    background: #39ff14;

    color: black;

    box-shadow:
        0 0 10px #39ff14,
        0 0 30px #39ff14;
}

.btn-green {
    background: #39ff14;
    color: black;
}

/* ================= SECTIONS ================= */

section {
    padding: 90px 0;
}

.container {
    width: 92%;
    max-width: 1200px;
    margin: auto;
}

.section-number {
    color: #39ff14;

    font-size: 12px;

    font-weight: bold;

    letter-spacing: 3px;

    margin-bottom: 12px;
}

h2 {
    font-size: clamp(35px, 6vw, 65px);

    line-height: 1;

    margin-bottom: 15px;
}

h2 span {
    color: #39ff14;
}

.description {
    color: #999;

    max-width: 750px;

    margin-bottom: 40px;
}

/* ================= VIDEO SAMPLES ================= */

.video-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;
}

.video-card {

    min-height: 300px;

    padding: 25px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    border: 1px solid #234c18;

    background:
        linear-gradient(
            145deg,
            rgba(57,255,20,.12),
            rgba(0,0,0,.8)
        );

    transition: .3s;
}

.video-card:hover {

    transform: translateY(-8px);

    border-color: #39ff14;

    box-shadow:
        0 0 30px rgba(57,255,20,.15);
}

.play {

    font-size: 60px;

    color: #39ff14;

    text-shadow:
        0 0 20px #39ff14;
}

.video-card h3 {

    font-size: 25px;

    margin: 10px 0;
}

.video-card p {

    color: #999;

    font-size: 14px;

    margin-bottom: 20px;
}

.video-link {

    color: #39ff14;

    font-weight: bold;

    text-decoration: none;
}

/* ================= SERVICES ================= */

.services {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 18px;
}

.service {

    padding: 30px;

    border: 1px solid #234c18;

    background: #080b07;

    transition: .3s;
}

.service:hover {

    border-color: #39ff14;

    transform: translateY(-5px);
}

.service-number {

    color: #39ff14;

    font-weight: bold;

    font-size: 12px;

    letter-spacing: 2px;
}

.service h3 {

    margin: 10px 0;

    font-size: 20px;
}

.service p {

    color: #999;

    font-size: 14px;
}

/* ================= PROCESS ================= */

.process {

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 15px;
}

.step {

    padding: 25px;

    border-left: 2px solid #39ff14;

    background: rgba(57,255,20,.04);
}

.step-number {

    color: #39ff14;

    font-size: 25px;

    font-weight: bold;
}

.step h3 {

    margin: 8px 0;
}

.step p {

    color: #999;

    font-size: 14px;
}

/* ================= PROMPT ================= */

.prompt-box {

    border: 1px solid #315d25;

    background: #010201;

    padding: 30px;

    font-family: Consolas, monospace;

    color: #d9ffd1;

    line-height: 2;

    overflow-x: auto;

    box-shadow:
        inset 0 0 30px rgba(57,255,20,.04);
}

.prompt-key {

    color: #39ff14;

    font-weight: bold;
}

/* ================= ABOUT ================= */

.about {

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 50px;

    align-items: center;
}

.about h3 {

    color: #39ff14;

    font-size: 30px;

    margin-bottom: 15px;
}

.about p {

    color: #aaa;

    margin-bottom: 15px;
}

/* ================= CONTACT ================= */

.contact-box {

    text-align: center;

    padding: 60px 25px;

    border: 1px solid #39ff14;

    background:
        radial-gradient(
            circle,
            rgba(57,255,20,.15),
            transparent 65%
        );
}

.contact-box h2 {

    margin-bottom: 20px;
}

.contact-box p {

    color: #999;

    max-width: 700px;

    margin: 0 auto 30px;
